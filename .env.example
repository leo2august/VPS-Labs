# =========================================================
# VPS Labs — application environment (.env)
# Set these before running; see README for full instructions.
# =========================================================

# Path to the Hermes agent home (used to read config.yaml / state.db / webui)
LABS_HERMES_DIR=/home/USER/.hermes

# Optional: path to a separate task-router router.py to read routing config
LABS_TASK_ROUTER_PY=/home/USER/task-router/router.py

# Optional: path to a 9router sqlite db
LABS_9ROUTER_DB=/home/USER/.9router/db/data.sqlite

# GateKey (OpenAI-compatible) endpoint used by the built-in Chat feature
LABS_GATEKEY_URL=https://ai.gatekey.cloud/v1/chat/completions
LABS_GATEKEY_KEY=

# Comma-separated public domains monitored on the Website tab (empty = disabled)
LABS_WEB_DOMAINS=https://example.com

# Comma-separated systemd services shown on Services / Service Control
LABS_SERVICES=caddy,fail2ban,ssh,nginx,postgresql

# SMTP for email password recovery (optional). Without it, email login works
# but reset links are not delivered.
LABS_SMTP_HOST=
LABS_SMTP_PORT=465
LABS_SMTP_USER=
LABS_SMTP_PASSWORD=
LABS_SMTP_FROM=
