<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wd_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="15dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/wd_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Labs" android:textColor="#F6F1E7"
            android:textSize="15sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="STORAGE" android:textColor="#DDBA55" android:textSize="9sp"
            android:textStyle="bold" android:letterSpacing="0.12" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/wd_percent" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="—" android:textColor="#EA777B"
            android:textSize="34sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/wd_used" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="#F6F1E7" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="USED" android:textColor="#71869F" android:textSize="8sp" android:letterSpacing="0.1" />
            <TextView android:id="@+id/wd_free" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:text="—" android:textColor="#79C99E" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="FREE" android:textColor="#71869F" android:textSize="8sp" android:letterSpacing="0.1" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/wd_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Memuat kapasitas…" android:textColor="#8494AA" android:textSize="10sp" />
</LinearLayout>
