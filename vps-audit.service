[Unit]
Description=Private VPS Labs Dashboard
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/ubuntu/vps-audit
ExecStart=/home/ubuntu/.hermes/hermes-agent/venv/bin/python /home/ubuntu/vps-audit/app.py
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
